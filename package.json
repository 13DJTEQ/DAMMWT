{
  "name": "@13djteq/mwt-dam-mvp",
  "version": "0.1.0",
  "description": "MWT Digital Asset Management MVP — Phase 1 review & approval workflow",
  "main": "dist/main.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/13DJTEQ/DAMMWT.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-schema.js && npm run build:renderer",
    "build:renderer": "node scripts/build-renderer.js",
    "clean": "rm -rf dist",
    "lint": "npm run typecheck",
    "test": "npm run verify",
    "dev": "npm run build && electron .",
    "start": "npm run build && electron .",
    "rebuild:native": "npx @electron/rebuild -f -w better-sqlite3",
    "review:electron": "bash scripts/review-electron.sh",
    "curate:media": "node scripts/curate-media.mjs",
    "push:media": "node scripts/push-media.mjs",
    "dam:section": "node scripts/push-media.mjs --create-section",
    "seed:media": "npm run build && node scripts/seed-media.mjs",
    "verify": "npm run build && node scripts/run-verify.mjs day1 && node scripts/run-verify.mjs day2 && node scripts/run-verify.mjs day5 && node scripts/run-verify.mjs day6 && node scripts/run-verify.mjs gallery",
    "verify:day1": "npm run build && node scripts/run-verify.mjs day1",
    "verify:day2": "npm run build && node scripts/run-verify.mjs day2",
    "verify:day5": "npm run build && node scripts/run-verify.mjs day5",
    "verify:day6": "npm run build && node scripts/run-verify.mjs day6",
    "verify:day34": "npm run build && node scripts/run-verify.mjs day34",
    "verify:gallery": "npm run build && node scripts/run-verify.mjs gallery",
    "verify:all": "npm run verify",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.renderer.json",
    "web:install": "npm install --prefix web",
    "web:dev": "npm run dev --prefix web",
    "web:build": "npm run build --prefix web",
    "web:preview": "npm run preview --prefix web",
    "web:typecheck": "npm run typecheck --prefix web",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/react-test-renderer": "^18.3.1",
    "electron": "^35.0.0",
    "esbuild": "^0.25.0",
    "react-test-renderer": "^18.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2"
  },
  "optionalDependencies": {}
}
